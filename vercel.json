{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix civicchain/frontend",
  "buildCommand": "npm run build --prefix civicchain/frontend",
  "outputDirectory": "civicchain/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
